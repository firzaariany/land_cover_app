# Google Earth Credentials
GOOGLE_EARTH_SERVICE_ACCOUNT="your-service-account-email"
GOOGLE_EARTH_KEY="/path/to/service-account-key.json"

# MODIS Land Cover Collection
MODIS_COLLECTION_ID="MODIS/061/MCD12Q1"
MODIS_COLLECTION_BAND_NAME="LC_Prop1"
MODIS_COLLECTION_RESOLUTION=500

# Land cover classes in MODIS_COLLECTION_ID: 1=Evergreen Needleleaf, 2=Evergreen Broadleaf,
# 3=Deciduous Needleleaf, 4=Deciduous Broadleaf, 5=Mixed Forests
FOREST_ONLY="True"
MODIS_FOREST_CODES=11,12,13,14,15

# LC_Prop1 (FAO-LCCS) forest subtype legend colors and labels, positionally paired with
# MODIS_FOREST_CODES above.
MODIS_FOREST_COLORS="#05450a,#086a10,#54a708,#78d203,#005a00"
MODIS_FOREST_LABELS="Evergreen Needleleaf Forests,Evergreen Broadleaf Forests,Deciduous Needleleaf Forests,Deciduous Broadleaf Forests,Mixed Broadleaf/Needleleaf Forests"

MODIS_AGRICULTURE_CODES=
MODIS_SETTLEMENT_CODES=

# Hansen Global Forest Change ("forest change") Collection
FOREST_CHANGE_COLLECTION_ID="UMD/hansen/global_forest_change_2025_v1_13"
FOREST_CHANGE_COLLECTION_BAND_NAME="lossyear"
FOREST_CHANGE_COLLECTION_RESOLUTION=30

# ESA CCI Above Ground Biomass Collection
BIOMASS_COLLECTION_ID="ESA/CCI/Above_Ground_Biomass/V6_0"
BIOMASS_COLLECTION_BAND_NAME="agb"
BIOMASS_COLLECTION_RESOLUTION=100
BIOMASS_COLLECTION_UNIT="Mg/ha"

# Global Administration Data
GADM_PATH="data/global_adm_borders.geojson"

# Global Forest Watch Credentials
GFW_API_KEY="your-gfw-account-key"
GFW_ACCESS_TOKEN="your-gfw-access-token"

# Global Forest Watch Collection Information
GFW_DATASET="gadm__tcl__iso_change"
GFW_DATASET_VERSION="v20260407"
GFW_API_URL="https://www.globalforestwatch.org/api/data/dataset/"
